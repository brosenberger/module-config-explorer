<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">brocode_configexplorer_listing.brocode_configexplorer_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>brocode_configexplorer_columns</spinner>
        <deps>
            <dep>brocode_configexplorer_listing.brocode_configexplorer_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="brocode_configexplorer_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">config_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>BroCode_ConfigExplorer::config_explorer</aclResource>
        <dataProvider class="BroCode\ConfigExplorer\Model\DataProvider"
                      name="brocode_configexplorer_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>config_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters">
            <filterSelect name="effective_scope" provider="${ $.parentName }">
                <settings>
                    <captionValue></captionValue>
                    <options class="BroCode\ConfigExplorer\Model\Config\ScopeOptions"/>
                    <label translate="true">Effective Scope</label>
                    <dataScope>effective_scope</dataScope>
                </settings>
            </filterSelect>
        </filters>
        <paging name="listing_paging"/>
        <!--
            Reacts to the AJAX "Effective Scope" filter above - hidden while it's
            unset or set to "default", visible for any website/store selection. The
            page-header store switcher's own equivalent notice is a full-reload
            message added server-side, in Controller/Adminhtml/Index/Index.php - it
            never touches this filter, so this component can't cover that path too.
        -->
        <container name="scope_notice" component="BroCode_ConfigExplorer/js/grid/scope-notice">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="scopeFilterName" xsi:type="string">brocode_configexplorer_listing.brocode_configexplorer_listing.listing_top.listing_filters.effective_scope</item>
                    <item name="content" xsi:type="string" translate="true">Showing every configuration value relevant to this scope: default values not overridden here, plus this scope's own overrides.</item>
                    <item name="additionalClasses" xsi:type="string">message message-notice brocode-config-explorer-scope-notice</item>
                </item>
            </argument>
        </container>
    </listingToolbar>
    <columns name="brocode_configexplorer_columns">
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">brocode_configexplorer_listing.brocode_configexplorer_listing.brocode_configexplorer_columns</item>
                </param>
            </childDefaults>
        </settings>
        <column name="config_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="path" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Path</label>
            </settings>
        </column>
        <column name="scope" sortOrder="30" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Scope</label>
                <options>
                    <option name="default" xsi:type="array">
                        <item name="value" xsi:type="string">default</item>
                        <item name="label" xsi:type="string" translate="true">Default</item>
                    </option>
                    <option name="websites" xsi:type="array">
                        <item name="value" xsi:type="string">websites</item>
                        <item name="label" xsi:type="string" translate="true">Websites</item>
                    </option>
                    <option name="stores" xsi:type="array">
                        <item name="value" xsi:type="string">stores</item>
                        <item name="label" xsi:type="string" translate="true">Stores</item>
                    </option>
                </options>
            </settings>
        </column>
        <column name="scope_id" sortOrder="40">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Scope ID</label>
            </settings>
        </column>
        <!--
            scope_code is computed per row in the data provider, not a core_config_data
            column - see DataProvider::resolveScopeCode(). Null (blank cell) for default
            scope, which has no code of its own. No filter/sort for the same reason
            is_encrypted/origin_label have none.
        -->
        <column name="scope_code" sortOrder="45">
            <settings>
                <label translate="true">Scope Code</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="value" sortOrder="50" component="BroCode_ConfigExplorer/js/grid/columns/value-with-origin">
            <settings>
                <filter>text</filter>
                <bodyTmpl>BroCode_ConfigExplorer/grid/cells/value-with-origin</bodyTmpl>
                <label translate="true">Value</label>
            </settings>
        </column>
        <!--
            is_encrypted is computed per row in the data provider, not a core_config_data
            column. It carries no filter and no sorting on purpose: either would push an
            unknown column into the SQL and break the grid.
        -->
        <column name="is_encrypted" sortOrder="60" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <dataType>select</dataType>
                <label translate="true">Encrypted</label>
                <sortable>false</sortable>
                <options>
                    <option name="yes" xsi:type="array">
                        <item name="value" xsi:type="string">1</item>
                        <item name="label" xsi:type="string" translate="true">Yes</item>
                    </option>
                    <option name="no" xsi:type="array">
                        <item name="value" xsi:type="string">0</item>
                        <item name="label" xsi:type="string" translate="true">No</item>
                    </option>
                </options>
            </settings>
        </column>
        <!--
            origin_label is computed per row in the data provider, not a core_config_data
            column - see DataProvider::getData(). "Database" for an unshadowed row,
            otherwise the deployment-config file (config.php / env.php / any other file a
            module registers) actually serving the value, so a config mishap traced to
            "why isn't my change taking effect" is visible at a glance. No filter/sort for
            the same reason is_encrypted has none: either would push an unknown column
            into the SQL and break the grid.
        -->
        <column name="origin_label" sortOrder="70">
            <settings>
                <label translate="true">Origin</label>
                <sortable>false</sortable>
            </settings>
        </column>
    </columns>
</listing>
